{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext", "lib": ["ES2022", "DOM"],
    "rootDir": ".", "outDir": "dist-server", "strict": true,
    "skipLibCheck": true, "esModuleInterop": true, "types": ["node"],
    "resolveJsonModule": true
  },
  "include": ["server/**/*.ts", "netlify/functions/**/*.ts"]
}
